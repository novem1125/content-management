{
  "name": "hono-drizzle-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --loader tsx src/server.ts",
    "build": "tsc",
    "migrate:dev": "drizzle-kit generate",
    "migrate:push": "drizzle-kit push",
    "lint": "eslint . --ext .ts",
    "prepare": "npm install"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "bcrypt": "^6.0.0",
    "bun": "^1.3.11",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "https": "^1.0.0",
    "minio": "^8.0.7",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/lib-storage": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
